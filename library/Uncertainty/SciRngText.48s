«
    @ SciRngText: the result of SciRngRnd written as text, keeping the
    @ trailing zeros the NIST rule makes significant (12.35±0.10, 12.20…12.56),
    @ which a number cannot carry. The display settings are not touched.
    @ After Jean Wilson's SciRngRnd (2025-2026).
    @ None of the helpers below calls another one: a program held in a local
    @ variable that names another local reaches the wrong variable when it runs
    @ under more local scopes than where it was written.

    @ Decimals for an uncertainty rounded to 2 significant digits: U → d
    «
        IF DUP 0 = THEN DROP 0 ELSE ABS LOG FLOOR 1 SWAP - R→I END
    »
    @ Any value as displayed, without the digit separators: V → "text"
    «
        →Str "" SWAP 1 OVER Size
        FOR SciPos
            DUP SciPos SciPos SUB
            IF DUP NUM 8287 == THEN DROP ELSE ROT SWAP + SWAP END
        NEXT
        DROP
    »
    @ Value with d decimals, written in full, zeros kept: V d → "text"
    «
        → Vc Dc
        «
            Vc ABS
            IF Dc 0 > THEN 10 Dc ^ × END
            0 RND R→I →Str
            @ keep the digits only, dropping the digit separators
            "" SWAP 1 OVER Size
            FOR SciPos
                DUP SciPos SciPos SUB
                IF DUP NUM DUP 48 ≥ SWAP 57 ≤ AND THEN ROT SWAP + SWAP ELSE DROP END
            NEXT
            DROP
            IF Dc 0 > THEN
                WHILE DUP Size Dc ≤ REPEAT "0" SWAP + END
                DUP 1 OVER Size Dc - SUB "." +
                SWAP DUP Size Dc - 1 + OVER Size SUB +
            END
            IF Vc 0 < THEN "-" SWAP + END
        »
    »
    → SciPlaces SciPlain SciFix
    «
        ⓁSciRngRnd
        @ Unit as text, with a plain space (" m"), and the interval without it
        IF DUP TypeName "unit" == THEN
            DUP 1 SWAP →Unit →Str 3 OVER Size SUB " " SWAP + SWAP UVAL
        ELSE
            "" SWAP
        END
        DUP TypeName SWAP Object→
        → SciUnit SciKind Ac Bc
        «
            CASE
                @ Zero uncertainty: nothing fixes the decimals, the value is written as is
                SciKind "range" == Ac Bc = AND THEN
                    Ac SciPlain "…" + Bc SciPlain +
                END
                SciKind "range" ≠ Bc 0 = AND THEN
                    Ac SciPlain
                    IF SciKind "uncertain" == THEN "±σ" ELSE "±" END + "0" +
                    IF SciKind "prange" == THEN "%" + END
                END
                SciKind "range" == THEN
                    Bc Ac - 2 ÷ SciPlaces → Dc
                    « Ac Dc SciFix "…" + Bc Dc SciFix + »
                END
                SciKind "prange" == THEN
                    Ac ABS Bc × 100 ÷ -2 RND SciPlaces → Dc
                    « Ac Dc SciFix "±" + Bc Bc SciPlaces SciFix + "%" + »
                END
                @ drange and uncertain: value, sign, uncertainty
                Bc SciPlaces → Dc
                « Ac Dc SciFix
                  IF SciKind "uncertain" == THEN "±σ" ELSE "±" END +
                  Bc Dc SciFix + »
            END
            SciUnit +
        »
    »
»
