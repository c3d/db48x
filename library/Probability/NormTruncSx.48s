  @ ------------------------------------------------------------
  IF DUP TypeName "list" == THEN IF DUP Size 4 == THEN Explode Drop ELSE IF DUP Size 5 == THEN Explode Drop Drop ELSE "NormTruncSx: needs 4 arguments" DoError END END END
